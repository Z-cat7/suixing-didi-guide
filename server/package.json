{
  "name": "dipi-server",
  "version": "1.0.0",
  "private": true,
  "description": "随行 dipi · 线下地陪服务交易平台 服务端（Node.js + Express + ws + JSON 文件持久化）",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "seed:force": "node src/db/seed.js --force",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "ws": "8.18.0"
  }
}
