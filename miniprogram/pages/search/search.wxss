/* 搜索页样式 */
.search__notice {
  margin-bottom: var(--dipi-space-3);
}

/* 搜索框 */
.search__bar {
  margin-top: var(--dipi-space-2);
  height: var(--dipi-touch-min);
}

.search__clear {
  width: 56rpx;
  height: 56rpx;
  margin-right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--dipi-ink-400);
}

/* 已选条件 chip 行 */
.search__chips {
  display: flex;
  flex-wrap: wrap;
  padding: var(--dipi-space-1) 0;
}

.search__chip {
  margin-bottom: var(--dipi-space-2);
}

.search__chip-close {
  font-size: var(--dipi-fs-caption);
  opacity: 0.7;
}

/* 结果列表 */
.search__list {
  padding-top: var(--dipi-space-1);
}

.search__empty {
  padding-top: var(--dipi-space-6);
}

/* 筛选抽屉 */
.search__sheet {
  max-height: 86vh;
}

.search__sheet-body {
  max-height: 60vh;
}

.search__group {
  margin-bottom: var(--dipi-space-6);
}

.search__group-title {
  display: block;
  margin-bottom: var(--dipi-space-3);
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-900);
}

.search__group-chips {
  display: flex;
  flex-wrap: wrap;
}

.search__sheet-actions {
  display: flex;
  align-items: center;
  padding: var(--dipi-space-4) var(--dipi-page-gutter);
  padding-bottom: calc(var(--dipi-safe-bottom) + var(--dipi-space-4));
  border-top: 1rpx solid var(--dipi-ink-200);
  background-color: var(--dipi-surface);
}

.search__reset {
  flex-shrink: 0;
  margin-right: var(--dipi-space-3);
  padding: 0 var(--dipi-space-4);
}

.search__apply {
  flex: 1;
  min-width: 0;
}

@media (max-width: 360px) {
  /* D0 微屏：筛选 chip 一行最多 3 个 */
  .search__group-chips .dipi-chip {
    max-width: 30%;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    display: flex;
  }
}
