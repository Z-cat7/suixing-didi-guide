/* 地陪详情页样式 */
.guide-detail__notice {
  margin-top: var(--dipi-space-3);
}

/* 照片轮播 */
.guide-detail__photos {
  margin-top: var(--dipi-space-3);
}

.guide-detail__swiper {
  width: 100%;
  height: 420rpx;
  border-radius: var(--dipi-radius-lg);
  overflow: hidden;
}

.guide-detail__photo {
  width: 100%;
  height: 100%;
}

/* 头部卡片 */
.guide-detail__card {
  margin-top: var(--dipi-space-4);
}

.guide-detail__head {
  display: flex;
  align-items: flex-start;
}

.guide-detail__avatar,
.guide-detail__avatar-skeleton {
  width: var(--dipi-guide-avatar);
  height: var(--dipi-guide-avatar);
  border-radius: var(--dipi-radius-full);
  background-color: var(--dipi-ink-100);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-detail__avatar-img {
  width: 100%;
  height: 100%;
}

.guide-detail__avatar-text {
  font-size: var(--dipi-fs-title);
  font-weight: var(--dipi-fw-semibold);
  color: var(--dipi-ink-400);
}

.guide-detail__head-col {
  flex: 1;
  min-width: 0;
  margin-left: var(--dipi-space-4);
}

.guide-detail__name {
  display: block;
  font-size: var(--dipi-fs-title);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-title);
  color: var(--dipi-ink-900);
}

.guide-detail__title {
  display: block;
  margin-top: var(--dipi-space-1);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-500);
}

.guide-detail__rating {
  display: flex;
  align-items: center;
  margin-top: var(--dipi-space-2);
}

.guide-detail__rating-num {
  margin-left: var(--dipi-space-2);
  font-size: var(--dipi-fs-caption);
  font-weight: var(--dipi-fw-semibold);
  color: var(--dipi-ink-700);
}

.guide-detail__rating-count {
  margin-left: var(--dipi-space-1);
  font-size: var(--dipi-fs-caption);
  color: var(--dipi-ink-500);
}

.guide-detail__tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--dipi-space-3);
}

.guide-detail__tags .dipi-guide-card__tag {
  margin-right: var(--dipi-space-2);
  margin-bottom: var(--dipi-space-2);
}

.guide-detail__verified {
  display: flex;
  align-items: center;
  margin-top: var(--dipi-space-3);
}

.guide-detail__verified-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--dipi-radius-full);
  background-color: var(--dipi-success-100);
  color: var(--dipi-success-700);
  font-size: var(--dipi-fs-label);
  text-align: center;
  line-height: 32rpx;
  margin-right: var(--dipi-space-2);
}

.guide-detail__verified-text {
  font-size: var(--dipi-fs-caption);
  color: var(--dipi-success-700);
}

/* 数据条 */
.guide-detail__stats {
  display: flex;
  margin-top: var(--dipi-space-4);
  padding: var(--dipi-space-4) 0;
}

.guide-detail__stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
}

.guide-detail__stat-value {
  font-family: var(--dipi-font-num);
  font-size: var(--dipi-fs-title);
  font-weight: var(--dipi-fw-bold);
  line-height: var(--dipi-line-title);
  color: var(--dipi-ink-900);
}

.guide-detail__stat-label {
  margin-top: var(--dipi-space-1);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-500);
}

/* 区块标题 */
.guide-detail__section-title {
  display: block;
  margin-bottom: var(--dipi-space-3);
  font-size: var(--dipi-fs-title);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-title);
  color: var(--dipi-ink-900);
}

.guide-detail__intro {
  display: block;
  font-size: var(--dipi-fs-body);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-700);
}

.guide-detail__highlights {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--dipi-space-3);
}

.guide-detail__highlights .dipi-guide-card__tag {
  margin-right: var(--dipi-space-2);
  margin-bottom: var(--dipi-space-2);
}

.guide-detail__meta {
  display: flex;
  align-items: center;
  margin-top: var(--dipi-space-3);
}

.guide-detail__meta-label {
  flex-shrink: 0;
  margin-right: var(--dipi-space-3);
  font-size: var(--dipi-fs-caption);
  color: var(--dipi-ink-500);
}

.guide-detail__meta-value {
  flex: 1;
  min-width: 0;
  font-size: var(--dipi-fs-caption);
  color: var(--dipi-ink-700);
}

/* 服务项 */
.guide-detail__service {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 120rpx;
  padding: var(--dipi-space-4) var(--dipi-space-3);
  margin-bottom: var(--dipi-space-3);
  border: 1rpx solid var(--dipi-ink-200);
  border-radius: var(--dipi-radius-md);
  box-sizing: border-box;
}

.guide-detail__service.is-active {
  border-color: var(--dipi-brand-600);
  background-color: var(--dipi-brand-50);
}

.guide-detail__service.is-disabled {
  opacity: 0.45;
}

.guide-detail__service-main {
  flex: 1;
  min-width: 0;
  margin-right: var(--dipi-space-3);
}

.guide-detail__service-title-row {
  display: flex;
  align-items: center;
}

.guide-detail__service-name {
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-900);
}

.guide-detail__service-tag {
  margin-left: var(--dipi-space-2);
  padding: 0 var(--dipi-space-2);
  height: 32rpx;
  line-height: 32rpx;
  border-radius: var(--dipi-radius-xs);
  background-color: var(--dipi-ink-100);
  font-size: var(--dipi-fs-label);
  color: var(--dipi-ink-500);
}

.guide-detail__service-desc {
  display: block;
  margin-top: var(--dipi-space-2);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-500);
}

.guide-detail__includes-text {
  display: block;
  margin-top: var(--dipi-space-2);
  font-size: var(--dipi-fs-label);
  color: var(--dipi-ink-500);
}

.guide-detail__service-skeleton {
  margin-top: var(--dipi-space-3);
}

/* 评价 */
.guide-detail__review {
  padding: var(--dipi-space-3) 0;
  border-top: 1rpx solid var(--dipi-ink-200);
}

.guide-detail__review:first-of-type {
  border-top: none;
  padding-top: 0;
}

.guide-detail__review-head {
  display: flex;
  align-items: center;
}

.guide-detail__review-name {
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-medium);
  color: var(--dipi-ink-900);
  margin-right: var(--dipi-space-2);
}

.guide-detail__review-time {
  margin-left: auto;
  font-size: var(--dipi-fs-label);
  color: var(--dipi-ink-500);
}

.guide-detail__review-content {
  display: block;
  margin-top: var(--dipi-space-2);
  font-size: var(--dipi-fs-body);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-700);
}

.guide-detail__review-reply {
  margin-top: var(--dipi-space-2);
  padding: var(--dipi-space-3);
  background-color: var(--dipi-ink-50);
  border-radius: var(--dipi-radius-sm);
}

.guide-detail__review-reply-label {
  display: block;
  font-size: var(--dipi-fs-label);
  color: var(--dipi-ink-500);
  margin-bottom: var(--dipi-space-1);
}

.guide-detail__review-reply-text {
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-700);
}

.guide-detail__more-btn {
  margin-top: var(--dipi-space-3);
}

/* 空态 */
.guide-detail__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--dipi-space-5) 0;
}

.guide-detail__empty-text {
  font-size: var(--dipi-fs-body);
  color: var(--dipi-ink-500);
}

.guide-detail__empty-btn {
  margin-top: var(--dipi-space-3);
}

/* 保障 */
.guide-detail__guarantee {
  display: flex;
  align-items: flex-start;
  min-height: 88rpx;
  padding: var(--dipi-space-3) 0;
}

.guide-detail__guarantee + .guide-detail__guarantee {
  border-top: 1rpx solid var(--dipi-ink-200);
}

.guide-detail__guarantee-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--dipi-radius-full);
  background-color: var(--dipi-brand-100);
  color: var(--dipi-brand-700);
  font-size: var(--dipi-fs-caption);
  text-align: center;
  line-height: 40rpx;
  flex-shrink: 0;
  margin-right: var(--dipi-space-3);
}

.guide-detail__guarantee-col {
  flex: 1;
  min-width: 0;
}

.guide-detail__guarantee-title {
  display: block;
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-medium);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-900);
}

.guide-detail__guarantee-desc {
  display: block;
  margin-top: var(--dipi-space-1);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-500);
}

/* 吸底条 */
.guide-detail__cta-bar {
  display: flex;
  align-items: center;
}

.guide-detail__cta-price {
  flex: 1;
  min-width: 0;
  margin-right: var(--dipi-space-3);
}

.guide-detail__cta-book {
  flex-shrink: 0;
  min-width: 240rpx;
}

/* 导航栏右侧操作（悬浮） */
.guide-detail__navbar-actions {
  position: fixed;
  right: var(--dipi-page-gutter);
  top: 140rpx;
  z-index: var(--dipi-z-sticky);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guide-detail__navbar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: var(--dipi-space-3);
  border-radius: var(--dipi-radius-full);
  background-color: var(--dipi-surface);
  box-shadow: var(--dipi-shadow-sm);
  color: var(--dipi-ink-700);
  font-size: var(--dipi-fs-title);
  line-height: 1;
}

.guide-detail__navbar-btn--text {
  width: auto;
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 var(--dipi-space-3);
  border-radius: var(--dipi-radius-full);
  font-size: var(--dipi-fs-caption);
  font-weight: var(--dipi-fw-medium);
  color: var(--dipi-brand-700);
}

/* 骨架辅助 */
.guide-detail__w30 { width: 30%; }
.guide-detail__w40 { width: 40%; }
.guide-detail__w50 { width: 50%; }
.guide-detail__w90 { width: 90%; }
