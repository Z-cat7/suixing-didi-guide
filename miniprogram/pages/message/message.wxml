<!--
  消息页（双 Tab：会话 / 通知）
  数据来源：GET /api/v1/conversations、GET /api/v1/notices、POST /api/v1/notices/read
-->
<view class="dipi-page dipi-page--tabbar dipi-page--narrow message">
  <!-- 离线提示条 -->
  <view wx:if="{{offline}}" class="dipi-notice dipi-notice--warning message__notice" aria-live="polite">
    网络连接已断开，显示的是上次缓存的内容
  </view>

  <!-- 双 Tab -->
  <view class="message__tabs">
    <view
      class="message__tab {{activeTab === 'conversation' ? 'is-active' : ''}}"
      hover-class="is-pressed"
      data-tab="conversation"
      bindtap="onTabChange"
      aria-role="tab"
      aria-selected="{{activeTab === 'conversation'}}"
      aria-label="会话，{{unreadTotal}} 条未读"
    >
      会话<text wx:if="{{unreadTotal > 0}}" class="message__tab-badge">{{unreadTotal > 99 ? '99+' : unreadTotal}}</text>
    </view>
    <view
      class="message__tab {{activeTab === 'notification' ? 'is-active' : ''}}"
      hover-class="is-pressed"
      data-tab="notification"
      bindtap="onTabChange"
      aria-role="tab"
      aria-selected="{{activeTab === 'notification'}}"
      aria-label="通知，{{unreadNoticeCount}} 条未读"
    >
      通知<text wx:if="{{unreadNoticeCount > 0}}" class="message__tab-badge">{{unreadNoticeCount}}</text>
    </view>
  </view>

  <!-- 通知 Tab 顶部：全部已读 -->
  <view wx:if="{{activeTab === 'notification' && unreadNoticeCount > 0}}" class="message__readall">
    <view
      class="message__readall-btn"
      hover-class="is-pressed"
      bindtap="onReadAllNotices"
      aria-role="button"
      aria-label="全部标记为已读"
    >
      全部已读
    </view>
  </view>

  <!-- 加载中 -->
  <skeleton-card wx:if="{{loading}}" type="msg" count="5" />

  <!-- 错误态 -->
  <empty-state
    wx:elif="{{error}}"
    type="error"
    title="加载失败"
    desc="网络好像不太稳定，点击重试"
    action-text="重试"
    bind:action="onRetry"
  />

  <block wx:else>
    <!-- 会话列表 -->
    <block wx:if="{{activeTab === 'conversation'}}">
      <empty-state
        wx:if="{{!conversationList.length}}"
        type="empty"
        title="还没有聊天"
        desc="咨询地陪，聊聊你的行程"
        action-text="去找地陪"
        bind:action="onFindGuide"
      />
      <view wx:else class="message__list">
        <message-item
          wx:for="{{conversationList}}"
          wx:key="conversationId"
          variant="conversation"
          item="{{item}}"
          bind:tap="onConversationTap"
        />
      </view>
    </block>

    <!-- 通知列表 -->
    <block wx:else>
      <empty-state
        wx:if="{{!noticeList.length}}"
        type="empty"
        title="暂无通知"
        desc="订单状态变化、售后进度会在这里通知你"
      />
      <view wx:else class="message__list">
        <message-item
          wx:for="{{noticeList}}"
          wx:key="notificationId"
          variant="notification"
          item="{{item}}"
          bind:tap="onNoticeTap"
        />
      </view>
    </block>

    <load-more status="{{loadMoreStatus}}" bind:retry="onRetryLoadMore" />
  </block>
</view>
