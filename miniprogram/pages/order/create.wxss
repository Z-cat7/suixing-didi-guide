/* 下单确认页样式 */
.order-create__notice {
  margin-top: var(--dipi-space-3);
  align-items: center;
  justify-content: space-between;
}

.order-create__notice-text {
  flex: 1;
  min-width: 0;
}

.order-create__notice-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  min-height: var(--dipi-touch-min);
  margin-left: var(--dipi-space-3);
  padding: 0 var(--dipi-space-3);
  font-size: var(--dipi-fs-caption);
  font-weight: var(--dipi-fw-semibold);
  color: var(--dipi-brand-700);
}

.order-create__card {
  margin-top: var(--dipi-space-4);
}

/* 地陪摘要 */
.order-create__summary {
  display: flex;
  align-items: center;
}

.order-create__summary-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--dipi-radius-full);
  background-color: var(--dipi-ink-100);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-create__summary-avatar-img {
  width: 100%;
  height: 100%;
}

.order-create__summary-avatar-text {
  font-size: var(--dipi-fs-title);
  color: var(--dipi-ink-400);
}

.order-create__summary-col {
  flex: 1;
  min-width: 0;
  margin-left: var(--dipi-space-3);
}

.order-create__summary-name {
  display: block;
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-900);
}

.order-create__summary-title {
  display: block;
  margin-top: var(--dipi-space-1);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-500);
}

/* 区块标题 */
.order-create__section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--dipi-space-3);
}

.order-create__section-title {
  display: block;
  margin-bottom: var(--dipi-space-3);
  font-size: var(--dipi-fs-title);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-title);
  color: var(--dipi-ink-900);
}

.order-create__section-head .order-create__section-title {
  margin-bottom: 0;
}

.order-create__offline-tag {
  font-size: var(--dipi-fs-label);
  color: var(--dipi-ink-500);
}

/* 时段 */
.order-create__slot-group {
  margin-bottom: var(--dipi-space-4);
}

.order-create__slot-date {
  display: block;
  margin-bottom: var(--dipi-space-3);
  font-size: var(--dipi-fs-caption);
  font-weight: var(--dipi-fw-medium);
  color: var(--dipi-ink-700);
}

.order-create__slot-list {
  display: flex;
  flex-wrap: wrap;
}

.order-create__slot {
  margin-right: var(--dipi-space-3);
  margin-bottom: var(--dipi-space-3);
  min-width: 140rpx;
}

.order-create__slot.is-disabled {
  opacity: 0.45;
}

/* 服务项 */
.order-create__service {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 96rpx;
  padding: var(--dipi-space-4) var(--dipi-space-3);
  margin-bottom: var(--dipi-space-3);
  border: 1rpx solid var(--dipi-ink-200);
  border-radius: var(--dipi-radius-md);
  box-sizing: border-box;
}

.order-create__service.is-active {
  border-color: var(--dipi-brand-600);
  background-color: var(--dipi-brand-50);
}

.order-create__service.is-disabled {
  opacity: 0.45;
}

.order-create__service-main {
  flex: 1;
  min-width: 0;
  margin-right: var(--dipi-space-3);
}

.order-create__service-name {
  display: block;
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-semibold);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-900);
}

.order-create__service-desc {
  display: block;
  margin-top: var(--dipi-space-2);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-ink-500);
}

/* 字段 */
.order-create__field-row {
  padding-left: 0;
  padding-right: 0;
}

/* 人数步进器 */
.order-create__stepper {
  display: flex;
  align-items: center;
  margin-left: auto;
}

.order-create__stepper-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--dipi-touch-min);
  height: var(--dipi-touch-min);
  border-radius: var(--dipi-radius-sm);
  background-color: var(--dipi-ink-100);
  color: var(--dipi-ink-700);
  font-size: var(--dipi-fs-title);
  line-height: 1;
}

.order-create__stepper-btn.is-disabled {
  color: var(--dipi-ink-400);
  opacity: 0.5;
}

.order-create__stepper-value {
  min-width: 72rpx;
  text-align: center;
  font-family: var(--dipi-font-num);
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-semibold);
  color: var(--dipi-ink-900);
}

/* 备注 */
.order-create__remark-field {
  padding: var(--dipi-space-4) 0 0;
}

.order-create__remark-label {
  display: block;
  margin-bottom: var(--dipi-space-3);
  font-size: var(--dipi-fs-body);
  color: var(--dipi-ink-900);
}

.order-create__remark {
  width: 100%;
  min-height: 160rpx;
  padding: var(--dipi-space-3);
  background-color: var(--dipi-ink-50);
  border: 1rpx solid var(--dipi-ink-200);
  border-radius: var(--dipi-radius-md);
  font-size: var(--dipi-fs-body);
  line-height: var(--dipi-line-body);
  color: var(--dipi-ink-900);
  box-sizing: border-box;
}

.order-create__counter {
  display: block;
  margin-top: var(--dipi-space-2);
  font-size: var(--dipi-fs-label);
  color: var(--dipi-ink-500);
  text-align: right;
}

/* 金额明细 */
.order-create__price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 48rpx;
  padding: var(--dipi-space-2) 0;
}

.order-create__price-label {
  font-size: var(--dipi-fs-body);
  color: var(--dipi-ink-500);
}

.order-create__price-value {
  flex: 1;
  min-width: 0;
  margin-left: var(--dipi-space-4);
  font-size: var(--dipi-fs-body);
  color: var(--dipi-ink-900);
  text-align: right;
}

.order-create__total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--dipi-space-4);
  padding-top: var(--dipi-space-3);
  border-top: 1rpx solid var(--dipi-ink-200);
}

.order-create__total-label {
  font-size: var(--dipi-fs-body);
  font-weight: var(--dipi-fw-medium);
  color: var(--dipi-ink-900);
}

.order-create__total-tip {
  display: block;
  margin-top: var(--dipi-space-2);
  font-size: var(--dipi-fs-caption);
  color: var(--dipi-ink-500);
  text-align: right;
}

/* 空态 */
.order-create__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--dipi-space-5) 0;
}

.order-create__empty-text {
  font-size: var(--dipi-fs-body);
  color: var(--dipi-ink-500);
}

.order-create__empty-btn {
  margin-top: var(--dipi-space-3);
}

/* 吸底 CTA */
.order-create__cta-bar {
  padding-top: var(--dipi-space-2);
}

.order-create__cta-error {
  display: block;
  margin-bottom: var(--dipi-space-2);
  font-size: var(--dipi-fs-caption);
  line-height: var(--dipi-line-caption);
  color: var(--dipi-error-700);
}

.order-create__cta {
  display: flex;
  align-items: center;
}

.order-create__cta-price {
  flex: 1;
  min-width: 0;
  margin-right: var(--dipi-space-3);
}

.order-create__cta-label {
  display: block;
  font-size: var(--dipi-fs-caption);
  color: var(--dipi-ink-500);
}

.order-create__cta-value {
  display: block;
  font-family: var(--dipi-font-num);
  font-size: var(--dipi-fs-price-lg);
  font-weight: var(--dipi-fw-bold);
  line-height: 48rpx;
  color: var(--dipi-accent-600);
}

.order-create__cta-btn {
  flex-shrink: 0;
  min-width: 240rpx;
}

/* 骨架辅助 */
.order-create__w30 { width: 30%; }
.order-create__w40 { width: 40%; }
.order-create__w90 { width: 90%; }
