/* guide-card · 地陪卡片组件样式
 * 基础视觉类来自 styles/components.wxss（.dipi-guide-card）
 */
.guide-card__img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 横向滑排模式：首页推荐模块 */
.guide-card--horizontal {
  width: 480rpx;
  margin-right: var(--dipi-space-4);
  margin-bottom: 0;
  flex-shrink: 0;
  flex-direction: column;
  align-items: stretch;
}

.guide-card--horizontal .dipi-guide-card__body {
  margin-left: 0;
  margin-top: var(--dipi-space-3);
}

.guide-card--horizontal .dipi-guide-card__aside {
  width: 100%;
  margin-left: 0;
  margin-top: var(--dipi-space-3);
  align-items: flex-start;
}

@media (min-width: 415px) {
  .guide-card--horizontal {
    width: 520rpx;
  }
}
